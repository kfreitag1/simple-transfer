# Any variable can be read from a file instead: set <NAME>_FILE to its path, e.g.
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret. A trailing newline is ignored

# Public origin. In dev this is the Vite server, which proxies /api to the API on PORT
BASE_URL=http://localhost:5173
# Origins Better Auth accepts auth requests from, in addition to BASE_URL. Only needed when the app
# is reachable on another origin. In development, BASE_URL is often the API (it is the OIDC redirect
# URI) while the page is served by Vite, so sign-out is refused without this
#TRUSTED_ORIGINS=http://localhost:5173

# openssl rand -hex 32
AUTH_SECRET=

# Register `${BASE_URL}/api/auth/callback/oidc` as the redirect URI at the provider
# These values match the mock provider in compose.dev.yaml
OIDC_ISSUER=http://localhost:8080/default
OIDC_CLIENT_ID=simple-transfer
OIDC_CLIENT_SECRET=secret
# Shown on the login page as "Sign in with <name>". Without it the button reads "Sign in"
#OIDC_PROVIDER_NAME=Authentik
#OIDC_SCOPES=openid profile email

#PORT=3000
# Set to true only behind a reverse proxy that sets X-Forwarded-For
#TRUST_PROXY=false
# Relative paths resolve against the repository root. compose.yaml sets both for the container
#DB_PATH=data/db/app.sqlite
#STORAGE_DIR=data/files
