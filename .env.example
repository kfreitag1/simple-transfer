# Public origin. In dev this is the Vite server, which proxies /api to the API on PORT.
BASE_URL=http://localhost:5173
# openssl rand -hex 32
AUTH_SECRET=

# Register `${BASE_URL}/api/auth/callback/oidc` as the redirect URI at the provider.
# These values match the mock provider in compose.dev.yaml.
OIDC_ISSUER=http://localhost:8080/default
OIDC_CLIENT_ID=simple-transfer
OIDC_CLIENT_SECRET=secret
#OIDC_SCOPES=openid profile email

#PORT=3000
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
#TRUST_PROXY=false
# Relative paths resolve against the repository root. compose.yaml sets both for the container.
#DB_PATH=data/db/app.sqlite
#STORAGE_DIR=data/files
